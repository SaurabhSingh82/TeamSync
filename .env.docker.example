# Local-only Docker Compose values. Never use these placeholders in production.
POSTGRES_DB=teamsync
POSTGRES_USER=teamsync
POSTGRES_PASSWORD=local-only-change-this-password
DJANGO_SECRET_KEY=local-only-not-a-production-secret-change-before-use-1234567890
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_BASE_URL=http://localhost:5173
AUTH_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://backend:8000
