# Copy to .env (or add these values to TEAMSYNC_ENV_FILE) and replace every
# placeholder locally. Do not commit .env or share these values in chat.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Local PostgreSQL. URL-encode special characters in the database password.
DATABASE_URL=postgresql://teamsync:replace-with-database-password@127.0.0.1:5432/teamsync
DATABASE_CONN_MAX_AGE=60

# Local browser origins. For deployment, use the exact HTTPS origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_BASE_URL=http://localhost:5173
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Gmail SMTP. Create a Google App Password after enabling 2-Step Verification.
# Never use the Gmail account's regular password here.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-sender@gmail.com
EMAIL_HOST_PASSWORD=replace-with-google-app-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=TeamSync <your-sender@gmail.com>

# Optional security, throttling, and storage settings.
SECURE_PROXY_SSL_HEADER=
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax
AUTH_REGISTER_RATE=10/hour
AUTH_EMAIL_RATE=5/hour
WORKSPACE_INVITATION_SEND_RATE=10/hour
INVITATION_ACCEPT_RATE=10/hour
# In local DEBUG mode this defaults to True so a new invitation is dispatched
# immediately after the database transaction commits.
INVITATION_SEND_IMMEDIATELY=True

# Local filesystem storage. Persist and back up these paths in production.
PRIVATE_ATTACHMENT_ROOT=backend/private_attachments
ATTACHMENT_MAX_SIZE_BYTES=10485760
ATTACHMENT_ALLOWED_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.gif,.webp,.txt,.csv

# Required only when using Docker Compose; these are local-only placeholders.
POSTGRES_DB=teamsync
POSTGRES_USER=teamsync
POSTGRES_PASSWORD=replace-with-local-database-password
